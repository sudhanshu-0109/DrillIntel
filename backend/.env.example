# ============================================================
# eRTMAC-NWIS Backend Environment Configuration
# Nearby Wells Intelligence System - Oil India Limited (SIH26121)
# ============================================================

# Database Connection
# SQLite local file default:
DATABASE_URL=sqlite:///./nwis_demo.db
# PostgreSQL + PostGIS production alternative:
# DATABASE_URL=postgresql://nwis_admin:nwis_secure_password_2026@localhost:5432/nwis_db

# Security & Authentication
JWT_SECRET=nwis-sih26121-oil-india-secure-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Operational Modes
DEMO_MODE=true
ENVIRONMENT=development

# LLM & Embeddings (Optional - local fallback hybrid BM25/TF-IDF works offline)
OPENAI_API_KEY=
EMBEDDING_API_KEY=

# Storage Paths
MODEL_STORAGE_PATH=./models
DOCUMENT_STORAGE_PATH=./data/documents

# Real-Time Telemetry Simulation
SIMULATOR_TICK_SECONDS=1.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
