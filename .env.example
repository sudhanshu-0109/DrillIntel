# Database Connection (PostgreSQL + PostGIS + pgvector in Docker)
DATABASE_URL=postgresql://nwis_admin:nwis_secure_password_2026@postgres:5432/nwis_db

# Security & JWT Tokens
JWT_SECRET=nwis-sih26121-oil-india-secure-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# System Mode
DEMO_MODE=true
ENVIRONMENT=production

# LLM & Vector Providers (Optional: Local hybrid TF-IDF/BM25 grounded engine works offline)
OPENAI_API_KEY=
EMBEDDING_API_KEY=

# Realtime Simulator
SIMULATOR_TICK_SECONDS=1.0

