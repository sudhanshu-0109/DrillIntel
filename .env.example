# ============================================================
# eRTMAC-NWIS Environment Configuration
# Nearby Wells Intelligence System - Oil India Limited (SIH26121)
# ============================================================

# Database Connection (Docker default is PostgreSQL + PostGIS + pgvector)
# For zero-dependency local dev without Docker, use: sqlite:///./nwis_demo.db
DATABASE_URL=postgresql://nwis_admin:nwis_secure_password_2026@localhost:5432/nwis_db

# Security & JWT Tokens
JWT_SECRET=nwis-sih26121-oil-india-secure-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# System Mode
DEMO_MODE=true
ENVIRONMENT=development

# LLM & Vector Providers (Optional: Local hybrid TF-IDF/BM25 grounded engine works offline)
OPENAI_API_KEY=
EMBEDDING_API_KEY=

# Realtime Simulator
SIMULATOR_TICK_SECONDS=1.0

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/live-well
VITE_GOOGLE_MAPS_API_KEY=
